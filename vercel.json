{
  "version": 2,
  "redirects": [
    {
      "source": "/hotdeals.html",
      "destination": "/",
      "permanent": false
    },
    {
      "source": "/brand",
      "destination": "/category",
      "permanent": false
    }
  ],
  "rewrites": [
    {
      "source": "/api/identity-review",
      "destination": "/api/history?__route=identity-review"
    },
    {
      "source": "/admin/identity-review",
      "destination": "/public/identity-review.html"
    },
    {
      "source": "/api/history-batch",
      "destination": "/api/history?__route=batch"
    },
    {
      "source": "/api/volatile-noon",
      "destination": "/api/cron?volatile=noon"
    },
    {
      "source": "/api/volatile-evening",
      "destination": "/api/cron?volatile=evening"
    },
    {
      "source": "/api/alternatives",
      "destination": "/api/history?__route=alternatives"
    },
    {
      "source": "/api/radar",
      "destination": "/api/history?__route=radar"
    },
    {
      "source": "/api/profile",
      "destination": "/api/sync?resource=profile"
    },
    {
      "source": "/p/:pid",
      "destination": "/api/history?__route=page&pid=:pid"
    },
    {
      "source": "/sitemap.xml",
      "destination": "/api/history?__route=sitemap-index"
    },
    {
      "source": "/sitemap-products.xml",
      "destination": "/api/history?__route=sitemap-index"
    },
    {
      "source": "/sitemaps/:file",
      "destination": "/api/history?__route=sitemap-file&file=:file"
    },
    {
      "source": "/category",
      "destination": "/api/history?__route=hub"
    },
    {
      "source": "/category/:slug",
      "destination": "/api/history?__route=category&slug=:slug"
    },
    {
      "source": "/brand/:slug",
      "destination": "/api/history?__route=brand&slug=:slug"
    },
    {
      "source": "/api/account/delete",
      "destination": "/api/auth?action=delete-account"
    },
    {
      "source": "/privacy",
      "destination": "/privacy.html"
    },
    {
      "source": "/terms",
      "destination": "/terms.html"
    },
    {
      "source": "/support",
      "destination": "/support.html"
    },
    {
      "source": "/((?!api/).*)",
      "destination": "/public/$1"
    }
  ],
  "headers": [
    {
      "source": "/(.*)",
      "headers": [
        {
          "key": "X-Content-Type-Options",
          "value": "nosniff"
        },
        {
          "key": "X-Frame-Options",
          "value": "SAMEORIGIN"
        },
        {
          "key": "Referrer-Policy",
          "value": "strict-origin-when-cross-origin"
        },
        {
          "key": "Permissions-Policy",
          "value": "geolocation=(), microphone=(), camera=(), payment=(), interest-cohort=()"
        },
        {
          "key": "Strict-Transport-Security",
          "value": "max-age=31536000; includeSubDomains"
        }
      ]
    },
    {
      "source": "/",
      "has": [
        {
          "type": "query",
          "key": "q"
        }
      ],
      "headers": [
        {
          "key": "X-Robots-Tag",
          "value": "noindex, follow"
        }
      ]
    },
    {
      "source": "/",
      "has": [
        {
          "type": "query",
          "key": "p"
        }
      ],
      "headers": [
        {
          "key": "X-Robots-Tag",
          "value": "noindex, follow"
        }
      ]
    },
    {
      "source": "/index.html",
      "has": [
        {
          "type": "query",
          "key": "q"
        }
      ],
      "headers": [
        {
          "key": "X-Robots-Tag",
          "value": "noindex, follow"
        }
      ]
    },
    {
      "source": "/index.html",
      "has": [
        {
          "type": "query",
          "key": "p"
        }
      ],
      "headers": [
        {
          "key": "X-Robots-Tag",
          "value": "noindex, follow"
        }
      ]
    },
    {
      "source": "/radar.html",
      "headers": [
        {
          "key": "X-Robots-Tag",
          "value": "noindex, follow"
        }
      ]
    },
    {
      "source": "/identity-review.html",
      "headers": [
        {
          "key": "X-Robots-Tag",
          "value": "noindex, nofollow"
        }
      ]
    },
    {
      "source": "/admin/identity-review",
      "headers": [
        {
          "key": "X-Robots-Tag",
          "value": "noindex, nofollow"
        }
      ]
    }
  ],
  "functions": {
    "api/cron.js": {
      "maxDuration": 60
    },
    "api/payment.js": {
      "maxDuration": 60
    },
    "api/ai.js": {
      "maxDuration": 40
    }
  },
  "regions": [
    "sin1"
  ],
  "crons": [
    {
      "path": "/api/cron",
      "schedule": "0 18 * * *"
    },
    {
      "path": "/api/volatile-noon",
      "schedule": "5 3 * * *"
    },
    {
      "path": "/api/volatile-evening",
      "schedule": "5 10 * * *"
    }
  ],
  "buildCommand": "node scripts/verify-ai-live.js --only merchantGuard2 --require-live-search --max-usd 1 --delay 22000 --out reports/merchant-guard-2-qa.json"
}
