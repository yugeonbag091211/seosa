{
  "version": 2,
  "redirects": [
    {
      "source": "/hotdeals.html",
      "destination": "/",
      "permanent": false
    },
    {
      "source": "/brand",
      "destination": "/category",
      "permanent": false
    }
  ],
  "rewrites": [
    {
      "source": "/api/history-batch",
      "destination": "/api/history?__route=batch"
    },
    {
      "source": "/api/alternatives",
      "destination": "/api/history?__route=alternatives"
    },
    {
      "source": "/api/radar",
      "destination": "/api/history?__route=radar"
    },
    {
      "source": "/api/profile",
      "destination": "/api/sync?resource=profile"
    },
    {
      "source": "/p/:pid",
      "destination": "/api/history?__route=page&pid=:pid"
    },
    {
      "source": "/sitemap.xml",
      "destination": "/api/history?__route=sitemap-index"
    },
    {
      "source": "/sitemap-products.xml",
      "destination": "/api/history?__route=sitemap-index"
    },
    {
      "source": "/sitemaps/:file",
      "destination": "/api/history?__route=sitemap-file&file=:file"
    },
    {
      "source": "/category",
      "destination": "/api/history?__route=hub"
    },
    {
      "source": "/category/:slug",
      "destination": "/api/history?__route=category&slug=:slug"
    },
    {
      "source": "/brand/:slug",
      "destination": "/api/history?__route=brand&slug=:slug"
    },
    {
      "source": "/((?!api/).*)",
      "destination": "/public/$1"
    }
  ],
  "headers": [
    {
      "source": "/(.*)",
      "headers": [
        {
          "key": "X-Content-Type-Options",
          "value": "nosniff"
        },
        {
          "key": "X-Frame-Options",
          "value": "SAMEORIGIN"
        },
        {
          "key": "Referrer-Policy",
          "value": "strict-origin-when-cross-origin"
        },
        {
          "key": "Permissions-Policy",
          "value": "geolocation=(), microphone=(), camera=(), payment=(), interest-cohort=()"
        },
        {
          "key": "Strict-Transport-Security",
          "value": "max-age=31536000; includeSubDomains"
        }
      ]
    },
    {
      "source": "/",
      "has": [
        {
          "type": "query",
          "key": "q"
        }
      ],
      "headers": [
        {
          "key": "X-Robots-Tag",
          "value": "noindex, follow"
        }
      ]
    },
    {
      "source": "/",
      "has": [
        {
          "type": "query",
          "key": "p"
        }
      ],
      "headers": [
        {
          "key": "X-Robots-Tag",
          "value": "noindex, follow"
        }
      ]
    },
    {
      "source": "/index.html",
      "has": [
        {
          "type": "query",
          "key": "q"
        }
      ],
      "headers": [
        {
          "key": "X-Robots-Tag",
          "value": "noindex, follow"
        }
      ]
    },
    {
      "source": "/index.html",
      "has": [
        {
          "type": "query",
          "key": "p"
        }
      ],
      "headers": [
        {
          "key": "X-Robots-Tag",
          "value": "noindex, follow"
        }
      ]
    },
    {
      "source": "/radar.html",
      "headers": [
        {
          "key": "X-Robots-Tag",
          "value": "noindex, follow"
        }
      ]
    }
  ],
  "functions": {
    "api/cron.js": {
      "maxDuration": 60
    },
    "api/payment.js": {
      "maxDuration": 60
    }
  },
  "crons": [
    {
      "path": "/api/cron",
      "schedule": "0 18 * * *"
    }
  ]
}
