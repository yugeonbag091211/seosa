# The app is a public client. Everything here is compiled into the bundle and readable by anyone.
# Only EXPO_PUBLIC_* values belong here — never Supabase service keys, Coupang/ADPICK secrets or admin tokens.
EXPO_PUBLIC_API_BASE_URL=https://seosa.ai.kr

# Public support address shown on the 마이 screen. Leave empty until it is decided —
# the app then shows "준비 중" (docs/STORE_READINESS.md keeps support as BLOCKED).
EXPO_PUBLIC_SUPPORT_EMAIL=
