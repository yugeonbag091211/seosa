{
  "cli": {
    "version": ">= 16.0.0",
    "appVersionSource": "remote",
    "requireCommit": true
  },
  "build": {
    "base": {
      "node": "22.23.2",
      "env": {
        "EXPO_PUBLIC_API_BASE_URL": "https://seosa.ai.kr"
      }
    },
    "development": {
      "extends": "base",
      "developmentClient": false,
      "distribution": "internal",
      "ios": { "simulator": true }
    },
    "preview": {
      "extends": "base",
      "distribution": "internal",
      "android": { "buildType": "apk" }
    },
    "production": {
      "extends": "base",
      "autoIncrement": true
    }
  },
  "submit": {
    "production": {}
  }
}
