{
  "cli": {
    "version": ">= 16.0.0",
    "appVersionSource": "local",
    "requireCommit": true
  },
  "build": {
    "base": {
      "node": "22.23.2",
      "pnpm": "11.27.0",
      "env": {
        "EXPO_PUBLIC_API_BASE_URL": "https://seosa.ai.kr"
      }
    },
    "beta": {
      "extends": "base",
      "distribution": "internal",
      "android": {
        "buildType": "apk"
      },
      "ios": {
        "simulator": false
      }
    },
    "beta-simulator": {
      "extends": "base",
      "distribution": "internal",
      "ios": {
        "simulator": true
      }
    }
  }
}
